# AuraOS environment template. Copy to .env and fill in values.
# Variable names come from src/config/env.ts (Zod schema) and docker-compose.yml.
# Never commit real values.

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=

# ── Database (required) ───────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>

# Used by docker-compose.yml for the Postgres container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── JWT (required) ────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# ── Payment gateway (optional; defaults to cash only) ──────
PAYMENT_GATEWAY=

# Razorpay (only if PAYMENT_GATEWAY=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (only if PAYMENT_GATEWAY=stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cashfree (only if PAYMENT_GATEWAY=cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# PayU (only if PAYMENT_GATEWAY=payu)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test

# ── WhatsApp (optional) ───────────────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ── Zomato (optional) ─────────────────────────────────────
ZOMATO_WEBHOOK_SECRET=

# ── Email / SMTP (password reset emails) ──────────────────
# Leave SMTP_HOST empty to log emails to the console in development
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Base URL of the frontend app (used in reset email links)
APP_URL=

# ── CORS (comma-separated allowed origins) ────────────────
CORS_ORIGIN=

# ── Monitoring (optional) ─────────────────────────────────
SENTRY_DSN=

# ── Platform super-admins (optional; comma-separated emails) ──
# Leave empty to lock cross-tenant endpoints for everyone
SUPER_ADMIN_EMAILS=

# ── Redis (optional) ──────────────────────────────────────
REDIS_URL=

# ── Multi-tenant routing ──────────────────────────────────
PLATFORM_DOMAIN=
DEV_TENANT_SLUG=
